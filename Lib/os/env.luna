import os_native

pub let getenv = os_native.getenv
pub let cwd = os_native.cwd
pub let separator = os_native.separator
pub let run = os_native.run
pub let system = os_native.system

pub fn getenv_or(name, default):
    let value = os_native.getenv(name)
    if value == nil:
        return default
    return value
