# @timeout: 60
# Bucle while largo con mutación de lista y comprobaciones al final.
import list
import assert

let xs = []
let i = 0
while i < 2000:
    list.push(xs, i)
    i = i + 1

let total = 0
let j = 0
while j < 2000:
    total += xs[j]
    j = j + 1

assert.eq(total, 1999000, "suma acumulada")
assert.eq(len(xs), 2000, "longitud")
assert.report()
