import string_native

pub let len = string_native.len
pub let concat = string_native.concat
pub let sub = string_native.sub
pub let upper = string_native.upper
pub let lower = string_native.lower
pub let trim = string_native.trim
pub let replace = string_native.replace

pub fn repeat(s, n):
    let out = ""
    let i = 0
    while i < n:
        out = concat(out, s)
        i += 1
    return out

pub fn reverse(s):
    let out = ""
    let i = len(s) - 1
    while i >= 0:
        out = concat(out, sub(s, i, i + 1))
        i -= 1
    return out

pub fn pad_left(s, width, ch):
    let missing = width - len(s)
    if missing <= 0:
        return s
    return concat(repeat(ch, missing), s)

pub fn pad_right(s, width, ch):
    let missing = width - len(s)
    if missing <= 0:
        return s
    return concat(s, repeat(ch, missing))
