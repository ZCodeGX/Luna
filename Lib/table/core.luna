import table_native

pub let new = table_native.new
pub let get = table_native.get
pub let set = table_native.set
pub let has = table_native.has
pub let remove = table_native.remove
pub let keys = table_native.keys
pub let len = table_native.len

pub fn get_or(t, key, default):
    if has(t, key):
        return get(t, key)
    return default

pub fn set_default(t, key, value):
    if not has(t, key):
        set(t, key, value)
    return get(t, key)

pub fn update(t, other):
    let names = keys(other)
    let i = 0
    while i < len(names):
        let key = names[i]
        set(t, key, get(other, key))
        i += 1
    return t
