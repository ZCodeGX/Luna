import math_native

pub let abs = math_native.abs
pub let floor = math_native.floor
pub let ceil = math_native.ceil
pub let round = math_native.round
pub let trunc = math_native.trunc
pub let sqrt = math_native.sqrt
pub let cbrt = math_native.cbrt
pub let exp = math_native.exp
pub let log = math_native.log
pub let log10 = math_native.log10
pub let log2 = math_native.log2
pub let pow = math_native.pow
pub let is_nan = math_native.isnan
pub let is_inf = math_native.isinf

pub fn sign(x):
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

pub fn clamp(x, lo, hi):
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

pub fn lerp(a, b, t):
    return a + (b - a) * t

pub fn gcd(a, b):
    let x = abs(a)
    let y = abs(b)
    while y != 0:
        let r = x % y
        x = y
        y = r
    return x

pub fn lcm(a, b):
    if a == 0 or b == 0:
        return 0
    return int(abs(a * b) / gcd(a, b))
