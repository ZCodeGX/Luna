import math
import string

print(math.min_of([3, 1, 2]))
print(math.max_of([3, 9, 2]))
print(math.tau)
print(math.clamp(5, 0, 3))
print(math.lerp(0, 10, 0.25))
print(math.gcd(48, 18))
print(math.lcm(4, 6))
print(math.hypotenuse(3, 4))
print(math.sum([1, 2, 3]))
let ordered = math.sort([3, 1, 2])
print(ordered[0])
print(math.median([3, 1, 2]))
print(math.randint(1, 2) >= 1)

print(string.reverse("abc"))
print(string.repeat("x", 3))
print(string.pad_left("7", 3, "0"))
print(string.pad_right("7", 3, "0"))
print(string.starts_with("luna", "lu"))
print(string.ends_with("luna", "na"))
print(string.join("-", [1, 2, 3]))
