import assert
import json

let value = {
    name = "luna",
    version = 2,
    ok = true,
    nothing = nil,
    tags = ["a", "b"],
    nested = { x = 10, y = [1, 2, 3] },
}

let text = json.encode(value)
let back = json.decode(text)

assert.eq(json.is_object(back), true, "decode produce tabla")
assert.eq(back.name, "luna", "campo name")
assert.eq(back.version, 2, "campo version")
assert.eq(back.ok, true, "campo ok")
assert.eq(back.nothing, nil, "campo null")
assert.eq(json.is_array(back.tags), true, "tags es lista")
assert.eq(len(back.tags), 2, "longitud tags")
assert.eq(back.tags[1], "b", "segundo tag")
assert.eq(json.is_object(back.nested), true, "nested es tabla")
assert.eq(back.nested.x, 10, "nested.x")
assert.eq(len(back.nested.y), 3, "nested.y len")
assert.eq(back.nested.y[2], 3, "nested.y[2]")

assert.eq(len(text) > 0, true, "encode no vacio")
assert.eq(json.stringify(value), text, "alias stringify")
let parsed = json.parse(text)
assert.eq(parsed.name, "luna", "alias parse")
assert.eq(json.encode({}), "{}", "tabla vacia")
assert.eq(json.encode([]), "[]", "lista vacia")
assert.eq(json.encode([1, "a", true, nil]), "[1,\"a\",true,null]", "compacto")
assert.eq(json.encode(-12.5), "-12.5", "float")

assert.report()
