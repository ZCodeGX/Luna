
fn fibonacci(n)
    if n < 2
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

fn main()
    let i = 0
    let sum = 0

    while i < 1000000
        sum = sum + ((i * 3 + 7) % 1009)
        i = i + 1

    print("LUNA - BUCLE")
    print(sum)

    print("LUNA - FIBONACCI")
    print(fibonacci(28))

main()
