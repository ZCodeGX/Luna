# Precedencia: ** (asociativa a la derecha) > unario - > * / % > + - >
# comparación > not > and > or. Usa paréntesis para dejar clara la intención.
print(2 ** 3 ** 2)     # 2 ** (3 ** 2) = 512
print(-2 ** 2)         # -(2 ** 2) = -4
print(2 ** -2)         # 0.25
print(1 + 2 * 3)       # 1 + 6 = 7
print((1 + 2) * 3)     # 9
print(10 - 3 - 2)      # asociación a izquierda: 5
print(not (1 == 2))    # not aplicado al resultado de la comparación
