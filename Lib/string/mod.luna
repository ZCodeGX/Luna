import string.core
import string.search
import string.splitting

pub let len = core.len
pub let concat = core.concat
pub let sub = core.sub
pub let upper = core.upper
pub let lower = core.lower
pub let trim = core.trim
pub let replace = core.replace
pub let repeat = core.repeat
pub let reverse = core.reverse
pub let pad_left = core.pad_left
pub let pad_right = core.pad_right

pub let find = search.find
pub let contains = search.contains
pub let starts_with = search.starts_with
pub let ends_with = search.ends_with

pub let split = splitting.split
pub let join = splitting.join
