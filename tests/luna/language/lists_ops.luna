import list
import assert

# Listas: indexar, asignar por índice, len y push/pop del módulo list.
# list.get(xs, -1) lee desde el final; xs[-1] directo no es válido.
let xs = [10, 20, 30]
print(xs[0])
xs[1] = 99
print(xs[1])
print(len(xs))
list.push(xs, 40)
print(list.get(xs, -1))
print(list.pop(xs))
assert.eq(len(xs), 3, "longitud")
assert.report()
